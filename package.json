{
	"name": "save-room",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.19 <23"
	},
	"scripts": {
		"dev": "vite dev --host 127.0.0.1",
		"build": "vite build && node scripts/configure-hosting.mjs",
		"preview": "vite preview --host 127.0.0.1",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint . --max-warnings 0",
		"lint:arch": "steiger src --fail-on-warnings",
		"validate:content": "tsx scripts/validate-content.ts",
		"test:unit": "vitest run",
		"test:e2e": "playwright test",
		"verify": "npm run format:check && npm run lint && npm run lint:arch && npm run check && npm run validate:content && npm run test:unit && npm run build"
	},
	"dependencies": {
		"svelte-ascii-ui": "0.2.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@feature-sliced/steiger-plugin": "^0.8.0",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^22.20.5",
		"eslint": "^10.4.1",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"sharp": "^0.35.5",
		"steiger": "^0.7.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	}
}
